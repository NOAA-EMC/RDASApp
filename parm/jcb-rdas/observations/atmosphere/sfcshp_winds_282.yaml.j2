- obs space:
    name: sfcshp_winds_282
    obsdatain:
      engine:
        type: H5File
        obsfile: "data/obs/ioda_sfcshp.nc"
        missing file action: "warn"
      # obsgrouping disabled: ioda's Halo assigns an entire record from its first location, which drops these horizontally-moving obs.
      # obsgrouping:
      #   group variables: ["stationIdentification"]
      #   sort variable: "pressure"
      #   sort order: "descending"
    obsdataout:
      empty obs space action: "{{empty_obs_space_action}}"
      write multiple files: {{write_multiple_files | default(false) }}
      engine:
        type: H5File
        obsfile: jdiag_sfcshp_winds_282.nc
        allow overwrite: true
    io pool:
      max pool size: {{ max_pool_size | default(1) }}
    observed variables: [windEastward, windNorthward]
    simulated variables: [windEastward, windNorthward]

  obs operator:
      name: VertInterp
      # Interpolate the lowest model wind to the observation height and
      # scale it to represent the observed 10 m wind.
      vertical coordinate: geopotential_height
      observation vertical coordinate: adjustedHeight
      observation vertical coordinate group: DerivedVariables
      interpolation method: linear
      hofx scaling field: SurfaceWindScalingHeight
      hofx scaling field group: DerivedVariables
      variables:
      - name: windEastward
      - name: windNorthward

  linear obs operator:
    name: VertInterp
    vertical coordinate: geopotential_height
    observation vertical coordinate: adjustedHeight
    observation vertical coordinate group: DerivedVariables
    interpolation method: linear
    hofx scaling field: SurfaceWindScalingHeight
    hofx scaling field group: DerivedVariables

  obs error:
    covariance model: diagonal

  obs filters:
    # Create the height coordinate and wind scaling used by VertInterp
    # so surface wind H(x) represents the reported 10 m wind.
    # Surface wind observations are reported 10 m above station elevation.
    - filter: Variable Assignment
      where:
      - variable:
          name: ObsType/windEastward
        is_in: [282]
      assignments:
      - name: MetaData/height
        type: int
        function:
          name: ObsFunction/Arithmetic
          options:
            variables: [MetaData/stationElevation]
            coefs: [1.0]
            intercept: 10.0
    - filter: Variable Transforms
      identifier:
        name: "VariableTransforms_AdjustedHeightCoordinate"
        logging: true
      Transform: AdjustedHeightCoordinate
      SkipWhenNoObs: False
    - filter: Variable Transforms
      identifier:
        name: "VariableTransforms_SurfaceWindScalingHeight"
        logging: true
      Transform: SurfaceWindScalingHeight
      SkipWhenNoObs: False
    # ------------------
    # wind (282)
    # ------------------
    # Accept, reject, or passivate (monitor)
    - filter: Perform Action
      identifier:
        name: "PerformAction_iuse_check"
        logging: true
      filter variables:
      - name: windEastward
      - name: windNorthward
      where:
      - variable: ObsType/windEastward
        is_in: 282
      action:
        name: {{iuse_sfcshp_winds_282 | default("passivate", true)}} # accept, reject, passivate

    # Reject all obs not in type
    - filter: Perform Action
      identifier:
        name: "PerformAction_obs_type_check"
        logging: true
      where:
      - variable: ObsValue/windEastward
        value: is_not_valid
      action:
        name: reduce obs space

    # Reject all obs not in kx
    - filter: Perform Action
      identifier:
        name: "PerformAction_obs_kx_check"
        logging: true
      where:
      - variable: ObsType/windEastward
        is_not_in: 282
      action:
        name: reduce obs space

    # Reject all obs with QualityMarker > 3
    - filter: RejectList
      identifier:
        name: "RejectList_quality_marker_check"
        logging: true
      filter variables:
      - name: windEastward
      - name: windNorthward
      where:
      - variable: QualityMarker/windEastward
        is_in: 4-15
        value: is_not_valid
      where operator: or
      action:
        name: reduce obs space

    # Time window filter
    - filter: Bounds Check
      identifier:
        name: "BoundsCheck_time_window_check"
        logging: true
      filter variables:
      - name: windEastward
      - name: windNorthward
      test variables:
      - name: MetaData/timeOffset
      minvalue: -5400
      maxvalue: 5400
      where:
      - variable: ObsType/windEastward
        is_in: 282
      action:
        name: reduce obs space

    # Duplicate Check
    - filter: DuplicateThinning
      identifier:
        name: "DuplicateThinning_duplicate_check"
        logging: true
      filter variables:
      - name: windEastward
      - name: windNorthward
      analysis_time: "{{ atmosphere_background_time_iso }}"
      analysis_time_tolerance: PT0S
      min_spacing: PT90M
      equidistant_time_selection: after
      variable names:
      - MetaData/longitude
      - MetaData/latitude
      tolerance:
      - 1.0e-6
      - 1.0e-6
      where:
      - variable: ObsType/windEastward
        is_in: 282
      action:
        name: reduce obs space

{% if use_online_domain_check | default(true) %}
    # Online domain check
    - filter: Bounds Check
      identifier:
        name: "BoundsCheck_online_domain_check"
        logging: true
      filter variables:
      - name: windEastward
      - name: windNorthward
      test variables:
      - name:  GeoVaLs/observable_domain_mask
      minvalue: 0.0
      maxvalue: 0.5
{% endif %}

    # Initial error assignment
    - filter: Perform Action
      identifier:
        name: "PerformAction_initial_error_assignment"
        logging: true
      filter variables:
      - name: windEastward
      - name: windNorthward
      where:
      - variable: ObsType/windEastward
        is_in: 282
      action:
        name: assign error
        error function:
          name: ObsFunction/ObsErrorModelStepwiseLinear
          options:
            xvar:
              name: MetaData/pressure
            xvals: [110000, 105000, 100000, 95000, 90000, 85000, 80000, 75000, 70000, 65000, 60000, 55000, 50000, 45000, 40000, 35000, 30000, 25000, 20000, 15000, 10000, 7500, 5000, 4000, 3000, 2000, 1000, 500, 400, 300, 200, 100, 0]
            errors: [1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079, 1.079]

