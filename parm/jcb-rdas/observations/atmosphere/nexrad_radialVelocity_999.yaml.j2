     - obs space:
         name: nexrad_radialVelocity_999
         obsdatain:
           engine:
             type: H5File
             obsfile: "data/obs/ioda_nexrad.nc"
             missing file action: "warn"
           obsgrouping:
             group variables: ["stationIdentification"]
             sort variable: "pressure"
             sort order: "descending"
         obsdataout:
           empty obs space action: "{{empty_obs_space_action}}"
           write multiple files: {{write_multiple_files | default(false) }}
           engine:
             type: H5File
             obsfile: jdiag_nexrad_radialVelocity_999.nc
             allow overwrite: true
         io pool:
           max pool size: {{ max_pool_size | default(1) }}
         observed variables: [radialVelocity]
         simulated variables: [radialVelocity]

       obs operator:
         name: RadarRadialVelocity
       linear obs operator:
         name: RadarRadialVelocity
       obs error:
         covariance model: diagonal

       obs filters:
         # ------------------
         # radialVelocity (999)
         # ------------------
         # Accept, reject, or passivate (monitor)
         - filter: Perform Action
           udescriptor: "iuse_check"
           filter variables:
           - name: radialVelocity
           where:
           - variable: ObsType/radialVelocity
             is_in: 999
           action:
             name: {{iuse_nexrad_radialVelocity_999 | default("passivate", true)}} # accept, reject, passivate

         # Reject all obs not in type
         - filter: Perform Action
           udescriptor: "obs_type_check"
           where:
           - variable: ObsValue/radialVelocity
             value: is_not_valid
           action:
             name: reduce obs space

         # Reject all obs not in kx
         - filter: Perform Action
           udescriptor: "obs_kx_check"
           where:
           - variable: ObsType/radialVelocity
             is_not_in: 999
           action:
             name: reduce obs space

         # Reject all obs with QualityMarker > 3
         - filter: RejectList
           udescriptor: "quality_marker_check"
           filter variables:
           - name: radialVelocity
           where:
           - variable: QualityMarker/radialVelocity
             is_in: 4-15
             value: is_not_valid
           where operator: or
           action:
             name: reduce obs space

         # Time window filter
         - filter: Bounds Check
           udescriptor: "time_window_check"
           filter variables:
           - name: radialVelocity
           test variables:
           - name: MetaData/timeOffset
           minvalue: -5400
           maxvalue: 5400
           where:
           - variable: ObsType/radialVelocity
             is_in: 999
           action:
             name: reduce obs space

         # Duplicate Check
         - filter: DuplicateThinning
           udescriptor: "duplicate_check"
           filter variables:
           - name: radialVelocity
           analysis_time: "{{ atmosphere_background_time_iso }}"
           analysis_time_tolerance: PT0S
           min_spacing: PT90M
           equidistant_time_selection: after
           variable names:
           - MetaData/longitude
           - MetaData/latitude
           tolerance:
           - 1.0e-6
           - 1.0e-6
           where:
           - variable: ObsType/radialVelocity
             is_in: 999
           action:
             name: reduce obs space

         # Online domain check
         - filter: Bounds Check
           udescriptor: "online_domain_check"
           filter variables:
           - name: radialVelocity
           test variables:
           - name:  GeoVaLs/observable_domain_mask
           minvalue: 0.0
           maxvalue: 0.5

         # Initial error assignment
         - filter: Perform Action
           udescriptor: "initial_error_assignment"
           filter variables:
           - name: radialVelocity
           where:
           - variable: ObsType/radialVelocity
             is_in: 999
           action:
             name: assign error
             error function:
               name: ObsFunction/ObsErrorModelStepwiseLinear
               options:
                 xvar:
                   name: MetaData/pressure
                 xvals: [110000, 105000, 100000, 95000, 90000, 85000, 80000, 75000, 70000, 65000, 60000, 55000, 50000, 45000, 40000, 35000, 30000, 25000, 20000, 15000, 10000, 7500, 5000, 4000, 3000, 2000, 1000, 500, 400, 300, 200, 100, 0]
                 errors: [5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0, 5.0]

{% if use_error_inflation | default(true) %}  # BEGIN use_error_inflation
         # Step a: get departure ObsMinusHofx = ObsValue -HofX
         - filter: Variable Assignment
           assignments:
           - name: DerivedMetaData/ObsMinusHofx
             type: float
             function:
               name: ObsFunction/Arithmetic
               options:
                 variables:
                 - name: ObsValue/radialVelocity
                 - name: HofX/radialVelocity
                 coefs: [1., -1.]

         # Error inflation based on residual, max inflation if diff > 20
         - filter: Perform Action
           filter variables:
           - name: radialVelocity
           where:
           - variable:
               name: DerivedMetaData/ObsMinusHofx
             minvalue: 20.0
           action:
             name: inflate error
             inflation factor: 2.0

         # Error inflation based on residual, max inflation if diff < -20
         - filter: Perform Action
           filter variables:
           - name: radialVelocity
           where:
           - variable:
               name: DerivedMetaData/ObsMinusHofx
             maxvalue: -20.0
           action:
             name: inflate error
             inflation factor: 2.0

         # step b: get infaltion factor for over-high topography (factelv)
         # function: factelv=(2000/elevation)**2

         # elev_sq = stationElevation**2
         - filter: Variable Assignment
           assignments:
           - name: DerivedMetaData/elev_sq
             type: float
             function:
               name: ObsFunction/ElementMultiply
               options:
                 variables:
                 - name: MetaData/stationElevation
                 exponents: [2.0]

         # factelv = elev_sq / 2000**2
         - filter: Variable Assignment
           assignments:
           - name: DerivedMetaData/factelv
             type: float
             function:
               name: ObsFunction/Arithmetic
               options:
                 variables:
                 - name: DerivedMetaData/elev_sq
                 coefs: [0.00000025]  # 1/2000**2

         # for elevation > 2000 m: inflation = elev_sq / 2000**2
         - filter: Perform Action
           filter variables:
           - name: radialVelocity
           where:
           - variable:
               name: MetaData/stationElevation
             minvalue: 2000.0001
           action:
             name: inflate error
             inflation variable:
               name: DerivedMetaData/factelv

         # Step c: get inflation factor if model and observation topography too different
         # factdif= (r200/(abs(zsges0-data(ielev,i))))**2

         # elev_diff = zsges0-data(ielev,i) = model elevation - station elevation
         - filter: Variable Assignment
           assignments:
           - name: DerivedMetaData/elev_diff
             type: float
             function:
               name: ObsFunction/Arithmetic
               options:
                 variables:
                 - name: GeoVaLs/height_above_mean_sea_level_at_surface
                 - name: MetaData/stationElevation
                 coefs: [1.0, -1.0]

         # elev_diff_sq = elev_diff**2
         - filter: Variable Assignment
           assignments:
           - name: DerivedMetaData/elev_diff_sq
             type: float
             function:
               name: ObsFunction/ElementMultiply
               options:
                 variables:
                 - name: DerivedMetaData/elev_diff
                 exponents: [2.0]

         # factdif = elev_diff_sq / 200**2
         - filter: Variable Assignment
           assignments:
           - name: DerivedMetaData/factdif
             type: float
             function:
               name: ObsFunction/Arithmetic
               options:
                 variables:
                 - name: DerivedMetaData/elev_diff_sq
                 coefs: [0.000025]

         # For elevation differences > 200 m: inflation = elev_diff_sq / 200**2
         - filter: Perform Action
           filter variables:
           - name: radialVelocity
           where:
           - variable:
               name: DerivedMetaData/elev_diff_sq
             minvalue: 40000.0001
           action:
             name: inflate error
             inflation variable:
               name: DerivedMetaData/factdif

{% endif %}  # END use_error_inflation

         # check if observation below model surface (zsges >= dpres)
           - filter: Bounds Check
           udescriptor: "bounds_check_below_model_surface"
           filter variables:
           - name: radialVelocity
           test variables:
           - name: ObsFunction/Arithmetic
             options:
               variables:
               - name: MetaData/height
               - name: GeoVaLs/height_above_mean_sea_level_at_surface
               coefs: [1.0,-1.0]
           minvalue: 0.0
           action:
             name: reject

         # Bounds Check (height)
         - filter: Bounds Check
           udescriptor: "bounds_check_height"
           filter variables:
           - name: radialVelocity
           test variables:
           - name: MetaData/height
           maxvalue: 20000.0
           action:
             name: reduce obs space

         # Bounds Check (ObsError)
         - filter: Bounds Check
           udescriptor: "bounds_check_ObsError"
           filter variables:
           - name: radialVelocity
           test variables:
           - name:  ObsErrorData/radialVelocity
           minvalue: 0.0
           maxvalue: 1000
           where:
           - variable: ObsType/radialVelocity
             is_in: 999
           action:
             name: reduce obs space

         # Bounds Check (ObsValue)
         - filter: Bounds Check
           udescriptor: "bounds_check_ObsValue"
           filter variables:
           - name: radialVelocity
           minvalue: -130
           maxvalue: 130
           where:
           - variable: ObsType/radialVelocity
             is_in: 999
           action:
             name: reduce obs space

         # Gross Error Check
         - filter: Background Check
           udescriptor: "gross_error_check"
           apply at iterations: 0,1
           filter variables:
           - name: radialVelocity
           function absolute threshold:
           - name: DerivedMetaData/ObsErrorBoundRW
           action:
             name: reject
           defer to post: true

         #- filter: GOMsaver
         #  filename: ./data/geovals/nexrad_geovals_rrfs.nc
