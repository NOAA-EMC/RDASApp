     - obs space:
         name: nexrad_radialVelocity_999
         obsdatain:
           engine:
             type: H5File
             obsfile: "data/obs/ioda_nexrad.nc"
             missing file action: "warn"
         obsdataout:
           empty obs space action: "{{empty_obs_space_action}}"
           write multiple files: {{write_multiple_files | default(false) }}
           engine:
             type: H5File
             obsfile: jdiag_nexrad_radialVelocity_999.nc
             allow overwrite: true
         io pool:
           max pool size: {{ max_pool_size | default(1) }}
         observed variables: [radialVelocity]
         simulated variables: [radialVelocity]

       obs operator:
         name: RadarDopplerWind
         vertical coordinate for horizontal wind: height_above_mean_sea_level
         vertical coordinate for vertical wind: height_above_mean_sea_level
       linear obs operator:
         name: RadarDopplerWind
         vertical coordinate for horizontal wind: height_above_mean_sea_level
         vertical coordinate for vertical wind: height_above_mean_sea_level
       obs error:
         covariance model: diagonal

       obs filters:
         # ------------------
         # radialVelocity (999)
         # ------------------
         # Accept, reject, or passivate (monitor)
         - filter: Perform Action
           udescriptor: "iuse_check"
           filter variables:
           - name: radialVelocity
           where:
           - variable: ObsType/radialVelocity
             is_in: 999
           action:
             name: {{iuse_nexrad_radialVelocity_999 | default("passivate", true)}} # accept, reject, passivate

         # Reject all obs not in type
         - filter: Perform Action
           udescriptor: "obs_type_check"
           where:
           - variable: ObsValue/radialVelocity
             value: is_not_valid
           action:
             name: reduce obs space

         # Reject all obs not in kx
         - filter: Perform Action
           udescriptor: "obs_kx_check"
           where:
           - variable: ObsType/radialVelocity
             is_not_in: 999
           action:
             name: reduce obs space

         ## Reject all obs with QualityMarker > 3
         #- filter: RejectList
         #  udescriptor: "quality_marker_check"
         #  filter variables:
         #  - name: radialVelocity
         #  where:
         #  - variable: QualityMarker/radialVelocity
         #    is_in: 4-15
         #    value: is_not_valid
         #  where operator: or
         #  action:
         #    name: reduce obs space

         # Time window filter
         - filter: Bounds Check
           udescriptor: "time_window_check"
           filter variables:
           - name: radialVelocity
           test variables:
           - name: MetaData/timeOffset
           minvalue: -5400
           maxvalue: 5400
           where:
           - variable: ObsType/radialVelocity
             is_in: 999
           action:
             name: reduce obs space

         ## Duplicate Check
         #- filter: DuplicateThinning
         #  udescriptor: "duplicate_check"
         #  filter variables:
         #  - name: radialVelocity
         #  analysis_time: "{{ atmosphere_background_time_iso }}"
         #  analysis_time_tolerance: PT0S
         #  min_spacing: PT90M
         #  equidistant_time_selection: after
         #  variable names:
         #  - MetaData/longitude
         #  - MetaData/latitude
         #  tolerance:
         #  - 1.0e-6
         #  - 1.0e-6
         #  where:
         #  - variable: ObsType/radialVelocity
         #    is_in: 999
         #  action:
         #    name: reduce obs space

         # Online domain check
         - filter: Bounds Check
           udescriptor: "online_domain_check"
           filter variables:
           - name: radialVelocity
           test variables:
           - name:  GeoVaLs/observable_domain_mask
           minvalue: 0.0
           maxvalue: 0.5

         # Match GSI's hard-coded no-VAD superob spread check.
         # This must run before ObsError is replaced with 5 m/s.
         - filter: Bounds Check
           udescriptor: "superob_spread_check"
           filter variables:
           - name: radialVelocity
           test variables:
           - name: ObsErrorData/radialVelocity
           minvalue: 1.0e-6
           maxvalue: 6.0
           where:
           - variable: ObsType/radialVelocity
             is_in: 999
           action:
             name: reduce obs space

         ## Initial error assignment
         #- filter: Perform Action
         #  udescriptor: "initial_error_assignment"
         #  filter variables:
         #  - name: radialVelocity
         #  where:
         #  - variable: ObsType/radialVelocity
         #    is_in: 999
         #  action:
         #    name: assign error
         #    error parameter: 5.0

{% if use_error_inflation | default(true) %}  # BEGIN use_error_inflation
         ## Step a: get departure ObsMinusHofx = ObsValue -HofX
         #- filter: Variable Assignment
         #  assignments:
         #  - name: DerivedMetaData/ObsMinusHofx
         #    type: float
         #    function:
         #      name: ObsFunction/Arithmetic
         #      options:
         #        variables:
         #        - name: ObsValue/radialVelocity
         #        - name: HofX/radialVelocity
         #        coefs: [1., -1.]
         #  defer to post: true

         ## Error inflation based on residual, max inflation if diff > 20
         #- filter: Perform Action
         #  filter variables:
         #  - name: radialVelocity
         #  where:
         #  - variable:
         #      name: DerivedMetaData/ObsMinusHofx
         #    minvalue: 20.0
         #  action:
         #    name: inflate error
         #    inflation factor: 2.0
         #  defer to post: true

         ## Error inflation based on residual, max inflation if diff < -20
         #- filter: Perform Action
         #  filter variables:
         #  - name: radialVelocity
         #  where:
         #  - variable:
         #      name: DerivedMetaData/ObsMinusHofx
         #    maxvalue: -20.0
         #  action:
         #    name: inflate error
         #    inflation factor: 2.0
         #  defer to post: true

         # step b: get infaltion factor for over-high topography (factelv)
         # function: factelv=(2000/elevation)**2

         # elev_sq = stationElevation**2
         - filter: Variable Assignment
           assignments:
           - name: DerivedMetaData/elev_sq
             type: float
             function:
               name: ObsFunction/ElementMultiply
               options:
                 variables:
                 - name: MetaData/stationElevation
                 exponents: [2.0]

         # factelv = elev_sq / 2000**2
         - filter: Variable Assignment
           assignments:
           - name: DerivedMetaData/factelv
             type: float
             function:
               name: ObsFunction/Arithmetic
               options:
                 variables:
                 - name: DerivedMetaData/elev_sq
                 coefs: [0.00000025]  # 1/2000**2

         # for elevation > 2000 m: inflation = elev_sq / 2000**2
         - filter: Perform Action
           filter variables:
           - name: radialVelocity
           where:
           - variable:
               name: MetaData/stationElevation
             minvalue: 2000.0001
           action:
             name: inflate error
             inflation variable:
               name: DerivedMetaData/factelv

         # Step c: get inflation factor if model and observation topography too different
         # factdif= (r200/(abs(zsges0-data(ielev,i))))**2

         # elev_diff = zsges0-data(ielev,i) = model elevation - station elevation
         - filter: Variable Assignment
           assignments:
           - name: DerivedMetaData/elev_diff
             type: float
             function:
               name: ObsFunction/Arithmetic
               options:
                 variables:
                 - name: GeoVaLs/height_above_mean_sea_level_at_surface
                 - name: MetaData/stationElevation
                 coefs: [1.0, -1.0]
           defer to post: true

         # elev_diff_sq = elev_diff**2
         - filter: Variable Assignment
           assignments:
           - name: DerivedMetaData/elev_diff_sq
             type: float
             function:
               name: ObsFunction/ElementMultiply
               options:
                 variables:
                 - name: DerivedMetaData/elev_diff
                 exponents: [2.0]
           defer to post: true

         # factdif = elev_diff_sq / 200**2
         - filter: Variable Assignment
           assignments:
           - name: DerivedMetaData/factdif
             type: float
             function:
               name: ObsFunction/Arithmetic
               options:
                 variables:
                 - name: DerivedMetaData/elev_diff_sq
                 coefs: [0.000025]
           defer to post: true

         # For elevation differences > 200 m: inflation = elev_diff_sq / 200**2
         - filter: Perform Action
           filter variables:
           - name: radialVelocity
           where:
           - variable:
               name: DerivedMetaData/elev_diff_sq
             minvalue: 40000.0001
           action:
             name: inflate error
             inflation variable:
               name: DerivedMetaData/factdif
           defer to post: true

{% endif %}  # END use_error_inflation

         # check if observation below model surface (zsges >= dpres)
         - filter: Bounds Check
           udescriptor: "bounds_check_below_model_surface"
           filter variables:
           - name: radialVelocity
           test variables:
           - name: ObsFunction/Arithmetic
             options:
               variables:
               - name: MetaData/height
               - name: GeoVaLs/height_above_mean_sea_level_at_surface
               coefs: [1.0,-1.0]
           minvalue: 0.0
           action:
             name: reject

         # Bounds Check (height)
         - filter: Bounds Check
           udescriptor: "bounds_check_height"
           filter variables:
           - name: radialVelocity
           test variables:
           - name: MetaData/height
           maxvalue: 20000.0
           action:
             name: reduce obs space

         # Bounds Check (ObsError)
         - filter: Bounds Check
           udescriptor: "bounds_check_ObsError"
           filter variables:
           - name: radialVelocity
           test variables:
           - name:  ObsErrorData/radialVelocity
           minvalue: 0.0
           maxvalue: 1000
           where:
           - variable: ObsType/radialVelocity
             is_in: 999
           action:
             name: reduce obs space

         # Bounds Check (ObsValue)
         - filter: Bounds Check
           udescriptor: "bounds_check_ObsValue"
           filter variables:
           - name: radialVelocity
           minvalue: -130
           maxvalue: 130
           where:
           - variable: ObsType/radialVelocity
             is_in: 999
           action:
             name: reduce obs space

         ## Apply a minimum error for assimilation. Unlike the gross-check clamp, this change is retained.
         #- filter: Perform Action
         #  udescriptor: "minimum_assimilation_error"
         #  apply at iterations: 0,1
         #  filter variables:
         #  - name: radialVelocity
         #  where:
         #  - variable:
         #      name: ObsErrorData/radialVelocity
         #    maxvalue: 2.0
         #  - variable: ObsType/radialVelocity
         #    is_in: 999
         #  action:
         #    name: assign error
         #    error parameter: 2.0
         #  defer to post: true

         # Create temporary ObsErrorData
         - filter: Variable Assignment
           udescriptor: "create_temporary_ObsErrorData"
           apply at iterations: 0,1
           where:
           - variable: ObsType/radialVelocity
             is_in: 999
           assignments:
           - name: RWObsErrorData/radialVelocity
             type: float
             function:
               name: ObsFunction/Arithmetic
               options:
                 variables:
                 - name: ObsErrorData/radialVelocity
           defer to post: true

         # Set ObsError set "error parameter" if < "max value"
         - filter: Perform Action
           udescriptor: "ermin_set"
           apply at iterations: 0,1
           filter variables:
           - name: radialVelocity
           action:
             name: assign error
             error parameter: 2.0
           where:
           - variable:
               name: ObsErrorData/radialVelocity
             maxvalue: 2.0
           - variable:
               name: ObsErrorData/radialVelocity
             value: is_valid
           - variable: ObsType/radialVelocity
             is_in: 999
           defer to post: true

         # Set ObsError set "error parameter" if > "min value"
         - filter: Perform Action
           udescriptor: "ermax_set"
           apply at iterations: 0,1
           filter variables:
           - name: radialVelocity
           action:
             name: assign error
             error parameter: 10.0
           where:
           - variable:
               name: ObsErrorData/radialVelocity
             minvalue: 10.0
           - variable:
               name: ObsErrorData/radialVelocity
             value: is_valid
           - variable: ObsType/radialVelocity
             is_in: 999
           defer to post: true

         # Gross Error Check
         - filter: Background Check
           udescriptor: "gross_error_check"
           apply at iterations: 0,1
           filter variables:
           - name: radialVelocity
           threshold: 5.0
           action:
             name: reject
           defer to post: true

         # Re-assign err ObsErrorData <--- RWObsErrorData after gross error check.
         - filter: Perform Action
           udescriptor: "reassign_error_RWObsErrorData"
           apply at iterations: 0,1
           filter variables:
           - name: radialVelocity
           action:
             name: assign error
             error function: RWObsErrorData/radialVelocity
           where:
           - variable:
               name: RWObsErrorData/radialVelocity
             value: is_valid
           - variable: ObsType/radialVelocity
             is_in: 999
           defer to post: true

         #- filter: GOMsaver
         #  filename: ./data/geovals/nexrad_geovals_rrfs.nc
