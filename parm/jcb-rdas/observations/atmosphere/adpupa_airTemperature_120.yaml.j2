- obs space:
    name: adpupa_airTemperature_120
    obsdatain:
      engine:
        type: H5File
        obsfile: "data/obs/ioda_adpupa.nc"
        missing file action: "warn"
      obsgrouping:
        group variables: ["stationIdentification"]
        sort variable: "pressure"
        sort order: "descending"
    obsdataout:
      empty obs space action: "{{empty_obs_space_action}}"
      write multiple files: {{write_multiple_files | default(false) }}
      engine:
        type: H5File
        obsfile: jdiag_adpupa_airTemperature_120.nc
        allow overwrite: true
    io pool:
      max pool size: {{ max_pool_size | default(1) }}
    observed variables: [airTemperature]
    simulated variables: [airTemperature]

  obs operator:
      name: VertInterp
      vertical coordinate: air_pressure
      observation vertical coordinate: pressure
      observation vertical coordinate group: MetaData
      interpolation method: log-linear
      variables:
      - name: airTemperature

  linear obs operator:
    name: VertInterp

  obs error:
    covariance model: diagonal

  obs filters:
    # ------------------
    # airTemperature (120)
    # ------------------
    # Accept, reject, or passivate (monitor)
    - filter: Perform Action
      identifier:
        name: "PerformAction_iuse_check"
        logging: true
      filter variables:
      - name: airTemperature
      where:
      - variable: ObsType/airTemperature
        is_in: 120
      action:
        name: {{iuse_adpupa_airTemperature_120 | default("passivate", true)}} # accept, reject, passivate

    # Reject all obs not in type
    - filter: Perform Action
      identifier:
        name: "PerformAction_obs_type_check"
        logging: true
      where:
      - variable: ObsValue/airTemperature
        value: is_not_valid
      action:
        name: reduce obs space

    # Reject all obs not in kx
    - filter: Perform Action
      identifier:
        name: "PerformAction_obs_kx_check"
        logging: true
      where:
      - variable: ObsType/airTemperature
        is_not_in: 120
      action:
        name: reduce obs space

    # Reject all obs with QualityMarker > 3
    - filter: RejectList
      identifier:
        name: "RejectList_quality_marker_check"
        logging: true
      filter variables:
      - name: airTemperature
      where:
      - variable: QualityMarker/airTemperature
        is_in: 4-15
        value: is_not_valid
      where operator: or
      action:
        name: reduce obs space

    # Time window filter
    - filter: Bounds Check
      identifier:
        name: "BoundsCheck_time_window_check"
        logging: true
      filter variables:
      - name: airTemperature
      test variables:
      - name: MetaData/timeOffset
      minvalue: -5400
      maxvalue: 5400
      where:
      - variable: ObsType/airTemperature
        is_in: 120
      action:
        name: reduce obs space

    # Duplicate Check
    - filter: DuplicateThinning
      identifier:
        name: "DuplicateThinning_duplicate_check"
        logging: true
      filter variables:
      - name: airTemperature
      analysis_time: "{{ atmosphere_background_time_iso }}"
      analysis_time_tolerance: PT0S
      min_spacing: PT90M
      equidistant_time_selection: after
      variable names:
      - MetaData/longitude
      - MetaData/latitude
      - MetaData/pressure
      tolerance:
      - 1.0e-6
      - 1.0e-6
      - 1.0e-6
      where:
      - variable: ObsType/airTemperature
        is_in: 120
      action:
        name: reduce obs space

{% if use_online_domain_check | default(true) %}
    # Online regional domain check
    - filter: Bounds Check
      identifier:
        name: "BoundsCheck_online_domain_check"
        logging: true
      filter variables:
      - name: airTemperature
      test variables:
      - name:  GeoVaLs/observable_domain_mask
      minvalue: 0.0
      maxvalue: 0.5
{% endif %}

    # Initial error assignment
    - filter: Perform Action
      identifier:
        name: "PerformAction_initial_error_assignment"
        logging: true
      filter variables:
      - name: airTemperature
      where:
      - variable: ObsType/airTemperature
        is_in: 120
      action:
        name: assign error
        error function:
          name: ObsFunction/ObsErrorModelStepwiseLinear
          options:
            xvar:
              name: MetaData/pressure
            xvals: [110000, 105000, 100000, 95000, 90000, 85000, 80000, 75000, 70000, 65000, 60000, 55000, 50000, 45000, 40000, 35000, 30000, 25000, 20000, 15000, 10000, 7500, 5000, 4000, 3000, 2000, 1000, 500, 400, 300, 200, 100, 0]
            errors: [1.2671, 1.3302, 1.4017, 1.4543, 1.4553, 1.3865, 1.2696, 1.1458, 1.0461, 0.98493, 0.95259, 0.9353, 0.92541, 0.92565, 0.94536, 0.99513, 1.0799, 1.1885, 1.2894, 1.3559, 1.3854, 1.3857, 1.3525, 1.3019, 1.2818, 1.3112, 1.3698, 1.4263, 1.4654, 1.4868, 1.4964, 1.4992, 1.4962]

{% if use_error_inflation | default(true) %}  # BEGIN use_error_inflation

    # Error inflation based on errormod (qcmod.f90)
    - filter: Perform Action
      identifier:
        name: "PerformAction_error_inflation_errormod"
        logging: true
      filter variables:
      - name: airTemperature
      where:
      - variable: ObsType/airTemperature
        is_in: 120
      action:
        name: inflate error
        inflation variable:
          name: ObsFunction/ObsErrorFactorConventional
          options:
            inflate variables: [airTemperature]
            pressure: MetaData/pressure

    # Error inflation when QualityMarker == 3 (read_prepbufr.f90)
    - filter: Perform Action
      identifier:
        name: "PerformAction_error_inflation_QualityMarker"
        logging: true
      filter variables:
      - name: airTemperature
      action:
        name: inflate error
        inflation factor: 1.2
      where:
      - variable: QualityMarker/airTemperature
        is_in: 3
      - variable: ObsType/airTemperature
        is_in: 120

    # Error inflation when observation pressure < 100 hPa (read_prepbufr.f90)
    - filter: Perform Action
      identifier:
        name: "PerformAction_error_inflation_observation_pressure"
        logging: true
      filter variables:
      - name: airTemperature
      action:
        name: inflate error
        inflation factor: 1.2
      where:
      - variable: MetaData/pressure
        maxvalue: 10000.0
        max_exclusive: true
      - variable: ObsType/airTemperature
        is_in: 120

    # Error inflation based on pressure check (setupt.f90)
    - filter: Perform Action
      identifier:
        name: "PerformAction_error_inflation_pressure_check"
        logging: true
      filter variables:
      - name: airTemperature
      where:
      - variable: ObsType/airTemperature
        is_in: 120
      action:
        name: inflate error
        inflation variable:
          name: ObsFunction/ObsErrorFactorPressureCheck
          options:
            variable: airTemperature
            surface observation error ramp: true
            max levels below surface: 15
            inflation factor: 8.0
{% endif %}  # END use_error_inflation

    # Bounds Check (ObsError)
    - filter: Bounds Check
      identifier:
        name: "BoundsCheck_bounds_check_ObsError"
        logging: true
      filter variables:
      - name: airTemperature
      test variables:
      - name:  ObsErrorData/airTemperature
      minvalue: 0.0
      maxvalue: 1000
      where:
      - variable: ObsType/airTemperature
        is_in: 120
      action:
        name: reduce obs space

    # Bounds Check (ObsValue)
    - filter: Bounds Check
      identifier:
        name: "BoundsCheck_bounds_check_ObsValue"
        logging: true
      filter variables:
      - name: airTemperature
      minvalue: 100
      maxvalue: 400
      where:
      - variable: ObsType/airTemperature
        is_in: 120
      action:
        name: reduce obs space

    # Create temporary ObsErrorData
    - filter: Variable Assignment
      udescriptor: "create_temporary_ObsErrorData"
      apply at iterations: 0,1
      where:
      - variable: ObsType/airTemperature
        is_in: 120
      assignments:
      - name: TempObsErrorData/airTemperature
        type: float
        function:
          name: ObsFunction/Arithmetic
          options:
            variables:
            - name: ObsErrorData/airTemperature
      defer to post: true

    # Set ObsError set "error parameter" if < "max value"
    - filter: Perform Action
      identifier:
        name: "PerformAction_ermin_set"
        logging: true
      apply at iterations: 0,1
      filter variables:
      - name: airTemperature
      action:
        name: assign error
        error parameter: 1.3
      where:
      - variable:
          name: ObsErrorData/airTemperature
        maxvalue: 1.3
      - variable:
          name: ObsErrorData/airTemperature
        value: is_valid
      - variable: ObsType/airTemperature
        is_in: 120
      defer to post: true

    # Set ObsError set "error parameter" if > "min value"
    - filter: Perform Action
      identifier:
        name: "PerformAction_ermax_set"
        logging: true
      apply at iterations: 0,1
      filter variables:
      - name: airTemperature
      action:
        name: assign error
        error parameter: 5.6
      where:
      - variable:
          name: ObsErrorData/airTemperature
        minvalue: 5.6
      - variable:
          name: ObsErrorData/airTemperature
        value: is_valid
      - variable: ObsType/airTemperature
        is_in: 120
      defer to post: true

    # Gross Error Check
    - filter: Background Check
      identifier:
        name: "BackgroundCheck_gross_error_check"
        logging: true
      apply at iterations: 0,1
      filter variables:
      - name: airTemperature
      threshold: 7.0
      action:
        name: reject
      where:
      - variable: QualityMarker/airTemperature
        is_not_in: 3
      - variable: ObsType/airTemperature
        is_in: 120
      defer to post: true

    # Gross Error Check: cgross*0.7 if QualityMarker=3
    - filter: Background Check
      identifier:
        name: "BackgroundCheck_gross_error_check_0.7"
        logging: true
      apply at iterations: 0,1
      filter variables:
      - name: airTemperature
      threshold: 4.9
      action:
        name: reject
      where:
      - variable: QualityMarker/airTemperature
        is_in: 3
      - variable: ObsType/airTemperature
        is_in: 120
      defer to post: true

    # Re-assign err ObsErrorData <--- TempObsErrorData after gross error check.
    - filter: Perform Action
      identifier:
        name: "PerformAction_reassign_error_TempObsErrorData"
        logging: true
      apply at iterations: 0,1
      filter variables:
      - name: airTemperature
      action:
        name: assign error
        error function: TempObsErrorData/airTemperature
      where:
      - variable:
          name: TempObsErrorData/airTemperature
        value: is_valid
      - variable: ObsType/airTemperature
        is_in: 120
      defer to post: true

    #- filter: GOMsaver
    #  filename: ./data/geovals/adpupa_geovals_rrfs.nc
